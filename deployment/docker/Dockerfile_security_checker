FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/security_checker ./cmd/security_checker

FROM alpine:3.21

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
RUN mkdir -p /app/log && chown -R appuser:appgroup /app
COPY --from=builder /app/bin/security_checker /app/security_checker
USER appuser
CMD ["/app/security_checker"]
